<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="2.88.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\DomainLayer\DomainLayer.csproj" />
    <ProjectReference Include="..\..\Core\Service\Service.csproj" />
    <ProjectReference Include="..\..\Core\ServiceAbstraction\ServiceAbstraction.csproj" />
    <ProjectReference Include="..\..\Shared\Shared.csproj" />
  </ItemGroup>

  <!-- The models live in biometric_test/ (single source of truth) and are copied
       into the API output so recognition runs in-process with no Python. -->
  <ItemGroup>
    <None Include="..\..\biometric_test\face_detection_yunet.onnx" Link="Models\face_detection_yunet.onnx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\biometric_test\face_recognition_sface.onnx" Link="Models\face_recognition_sface.onnx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\biometric_test\anti_spoof_2.7_80x80.onnx" Link="Models\anti_spoof_2.7_80x80.onnx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\biometric_test\anti_spoof_4.0_80x80.onnx" Link="Models\anti_spoof_4.0_80x80.onnx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Transitive-package security pins: elevate the vulnerable resolved versions (see reports/package-audit log, advisory GHSA-qj66-m88j-hmgj / GHSA-8g4q-xg66-9fp4). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" /> <!-- transitive security pin (CVE-2024-43483 / CVE-2024-43485) -->
  </ItemGroup>

</Project>
