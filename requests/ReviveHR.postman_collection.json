{
  "info": {
    "name": "Revive HR System API",
    "_postman_id": "b7f3c1a2-5e64-4d18-9c07-2a1f0b6d84e1",
    "description": "Revive HR System API - full surface, one folder per controller.\n\n**Auto-JWT**: a collection-level pre-request script signs in once per run and injects `Bearer {{accessToken}}` into every request, so no manual token handling is needed. Requests that must stay anonymous opt out with the header `X-Skip-Auth: true`.\n\nSelect the **Revive HR - Dev** environment before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "/**",
          " * Auto-JWT - signs in once per run and injects the bearer token into every request.",
          " * Login is rate limited (10/min), so a still-valid token is always reused.",
          " * Opt out per request with the header  X-Skip-Auth: true  (anonymous-access tests).",
          " */",
          "const BASE_URL = pm.environment.get('baseUrl') || pm.collectionVariables.get('baseUrl');",
          "const LOGIN_PATH = '/api/auth/login';",
          "",
          "if (pm.request.headers.get('X-Skip-Auth') === 'true') {",
          "  pm.request.headers.remove('X-Skip-Auth');",
          "  return; // deliberately anonymous request",
          "}",
          "",
          "if (pm.request.url.toString().includes(LOGIN_PATH)) {",
          "  return; // never authenticate the login call itself",
          "}",
          "",
          "// Reuse a token that is not about to expire (60s skew).",
          "const token = pm.environment.get('accessToken');",
          "const expiresAt = Number(pm.environment.get('accessTokenExpiresAt') || 0);",
          "if (token && expiresAt - 60000 > Date.now()) {",
          "  pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + token });",
          "  return;",
          "}",
          "",
          "const res = await pm.sendRequest({",
          "  url: BASE_URL + LOGIN_PATH,",
          "  method: 'POST',",
          "  header: { 'Content-Type': 'application/json' },",
          "  body: {",
          "    mode: 'raw',",
          "    raw: JSON.stringify({",
          "      email: pm.environment.get('autoLoginEmail'),",
          "      password: pm.environment.get('autoLoginPassword')",
          "    })",
          "  }",
          "});",
          "",
          "if (res.code !== 200) {",
          "  console.error('[auto-login] ' + res.code + ' ' + res.text());",
          "  throw new Error('Auto-login failed with HTTP ' + res.code);",
          "}",
          "",
          "let data = res.json();",
          "",
          "// Employees scoped to two gyms get a selection challenge instead of a token.",
          "if (data.requiresGymSelection && data.tempSessionToken) {",
          "  const preferred = Number(pm.environment.get('autoLoginGymId') || 0);",
          "  const gym = (data.gyms || []).find(g => g.gymId === preferred) || (data.gyms || [])[0];",
          "  if (!gym) throw new Error('Auto-login: gym selection required but no gyms returned');",
          "  const pick = await pm.sendRequest({",
          "    url: BASE_URL + LOGIN_PATH + '/select-gym',",
          "    method: 'POST',",
          "    header: { 'Content-Type': 'application/json' },",
          "    body: { mode: 'raw', raw: JSON.stringify({ gymId: gym.gymId, tempSessionToken: data.tempSessionToken }) }",
          "  });",
          "  if (pick.code !== 200) {",
          "    console.error('[auto-login] select-gym ' + pick.code + ' ' + pick.text());",
          "    throw new Error('Auto-login gym selection failed with HTTP ' + pick.code);",
          "  }",
          "  data = pick.json();",
          "}",
          "",
          "pm.environment.set('accessToken', data.accessToken);",
          "pm.environment.set('accessTokenExpiresAt', String(Date.now() + Number(data.expiresInSeconds || 0) * 1000));",
          "if (data.user) pm.environment.set('currentUser', data.user.email);",
          "",
          "pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + data.accessToken });"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5248",
      "type": "string",
      "description": "Fallback base URL, used only when no environment is selected."
    }
  ],
  "item": [
    {
      "name": "01 - Auth",
      "description": "AuthController - `/api/auth`. Email + password to access token. Both endpoints are anonymous; everything else in the API needs this token.",
      "item": [
        {
          "name": "Login - Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "POST /api/auth/login - super admin. Returns an access token directly (no gym challenge)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Returns an access token', () =>",
                  "  pm.expect(json.accessToken).to.be.a('string').and.not.empty);",
                  "",
                  "pm.test('Echoes the signed-in user', () => {",
                  "  pm.expect(json.user.email).to.eql(pm.environment.get('adminEmail'));",
                  "  pm.expect(json.user.id).to.be.a('number');",
                  "});",
                  "",
                  "pm.test('Admin is not challenged for gym selection', () =>",
                  "  pm.expect(json.requiresGymSelection).to.eql(false));",
                  "",
                  "pm.test('Advertises a positive token lifetime', () =>",
                  "  pm.expect(json.expiresInSeconds).to.be.above(0));",
                  "",
                  "pm.test('Token is a JWT with three segments', () =>",
                  "  pm.expect(json.accessToken.split('.')).to.have.lengthOf(3));",
                  "",
                  "// Keep the token for the rest of the run.",
                  "pm.environment.set('accessToken', json.accessToken);",
                  "pm.environment.set('accessTokenExpiresAt', String(Date.now() + json.expiresInSeconds * 1000));",
                  "pm.environment.set('currentUser', json.user.email);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Employee",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{employeeEmail}}\",\n  \"password\": \"{{employeePassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "POST /api/auth/login - employee session scoped to one gym. An employee with access to two gyms gets a selection challenge instead of a token; the test captures `tempSessionToken` so **Select Gym** can use it."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Echoes the signed-in employee', () =>",
                  "  pm.expect(json.user.email).to.eql(pm.environment.get('employeeEmail')));",
                  "",
                  "pm.test('Either a token or a gym challenge', () => {",
                  "  if (json.requiresGymSelection) {",
                  "    pm.expect(json.accessToken, 'no token before gym selection').to.eql(null);",
                  "    pm.expect(json.tempSessionToken).to.be.a('string').and.not.empty;",
                  "    pm.expect(json.gyms).to.be.an('array').with.length.above(0);",
                  "    pm.environment.set('tempSessionToken', json.tempSessionToken);",
                  "    pm.environment.set('availableGyms', JSON.stringify(json.gyms));",
                  "  } else {",
                  "    pm.expect(json.accessToken).to.be.a('string').and.not.empty;",
                  "    pm.expect(json.user.gymId).to.be.a('number');",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Select Gym",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gymId\": {{gymId}},\n  \"tempSessionToken\": \"{{tempSessionToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login/select-gym",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login", "select-gym"]
            },
            "description": "POST /api/auth/login/select-gym - completes a two-gym employee login. Run **Login - Employee** first so `{{tempSessionToken}}` is populated."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Skipped (not failed) when the employee has only one gym and never got a challenge.",
                  "if (!pm.environment.get('tempSessionToken')) {",
                  "  pm.execution.skipRequest();",
                  "}",
                  "",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Returns the access token', () =>",
                  "  pm.expect(json.accessToken).to.be.a('string').and.not.empty);",
                  "",
                  "pm.test('Session is scoped to the chosen gym', () =>",
                  "  pm.expect(json.user.gymId).to.eql(Number(pm.environment.get('gymId'))));",
                  "",
                  "pm.test('Challenge is resolved', () =>",
                  "  pm.expect(json.requiresGymSelection).to.eql(false));",
                  "",
                  "pm.environment.set('accessToken', json.accessToken);",
                  "pm.environment.set('accessTokenExpiresAt', String(Date.now() + json.expiresInSeconds * 1000));",
                  "pm.environment.set('currentUser', json.user.email);",
                  "pm.environment.set('tempSessionToken', '');"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Wrong Password (expect 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"definitely-wrong\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Negative test - the error is identical to an unknown email, so the endpoint cannot be used to enumerate accounts."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Error code is INVALID_CREDENTIALS', () =>",
                  "  pm.expect(json.error).to.eql('INVALID_CREDENTIALS'));",
                  "",
                  "pm.test('Uses the project error envelope', () => {",
                  "  pm.expect(json.statusCode).to.eql(401);",
                  "  pm.expect(json.message).to.be.a('string');",
                  "  pm.expect(json.errors).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Never leaks a token', () =>",
                  "  pm.expect(json.accessToken).to.eql(undefined));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Missing Email (expect 400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Negative test - model-state validation is returned in the project envelope instead of ProblemDetails."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Error code is VALIDATION_FAILED', () =>",
                  "  pm.expect(json.error).to.eql('VALIDATION_FAILED'));",
                  "",
                  "pm.test('Reports the offending field', () => {",
                  "  pm.expect(json.errors).to.be.an('array').with.length.above(0);",
                  "  pm.expect(json.errors[0].field).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Attendance",
      "description": "AttendanceController - `/api/attendance`. Public station endpoints: every request carries only the gym's 6-digit station code and the gym is resolved server-side. No JWT and no device token.\n\n`timestamp` is optional throughout - omit it to use server time. Requests are order-sensitive: run **Check In - Biometric** before the duplicate and check-out tests.",
      "item": [
        {
          "name": "Check In - Biometric",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{gym1StationCode}}\",\n  \"employeeId\": \"{{employeeKarim}}\",\n  \"type\": \"IN\",\n  \"livenessScore\": 0.95\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/attendance/events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "attendance", "events"]
            },
            "description": "POST /api/attendance/events - face check-in. A liveness score below 0.70 is rejected, so this uses 0.95."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Echoes the employee that was scanned', () =>",
                  "  pm.expect(json.employeeId).to.eql(pm.environment.get('employeeKarim')));",
                  "",
                  "pm.test('Recorded as a biometric check-in', () => {",
                  "  pm.expect(json.type).to.eql('IN');",
                  "  pm.expect(json.method).to.eql('Biometric');",
                  "});",
                  "",
                  "pm.test('Gym resolved from the station code', () => {",
                  "  pm.expect(json.gymId).to.be.a('number');",
                  "  pm.expect(json.gymName).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.test('Returns a record id and a timestamp', () => {",
                  "  pm.expect(json.recordId).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.timestamp).to.be.a('string');",
                  "});",
                  "",
                  "pm.test('Compared against today shift', () =>",
                  "  pm.expect(json.shiftComparison).to.eql('ON_SCHEDULE'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Check Out - Biometric",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{gym1StationCode}}\",\n  \"employeeId\": \"{{employeeKarim}}\",\n  \"type\": \"OUT\",\n  \"livenessScore\": 0.95\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/attendance/events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "attendance", "events"]
            },
            "description": "POST /api/attendance/events - face check-out. Requires a check-in first, so run **Check In - Biometric** before this."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Recorded as a biometric check-out', () =>",
                  "  pm.expect(json.type).to.eql('OUT'));",
                  "",
                  "pm.test('Same employee', () =>",
                  "  pm.expect(json.employeeId).to.eql(pm.environment.get('employeeKarim')));",
                  "",
                  "pm.test('Returns a record id', () =>",
                  "  pm.expect(json.recordId).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "Duplicate Check In (expect 409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{gym1StationCode}}\",\n  \"employeeId\": \"{{employeeKarim}}\",\n  \"type\": \"IN\",\n  \"livenessScore\": 0.95\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/attendance/events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "attendance", "events"]
            },
            "description": "Negative test - a second check-in on the same day conflicts. Run after **Check In - Biometric**."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 409 Conflict', () => pm.response.to.have.status(409));",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Error code is ALREADY_CHECKED_IN', () =>",
                  "  pm.expect(json.error).to.eql('ALREADY_CHECKED_IN'));",
                  "",
                  "pm.test('Uses the project error envelope', () => {",
                  "  pm.expect(json.statusCode).to.eql(409);",
                  "  pm.expect(json.message).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Check In - Low Liveness (expect 422)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{gym1StationCode}}\",\n  \"employeeId\": \"{{employeeOmar}}\",\n  \"type\": \"IN\",\n  \"livenessScore\": 0.42\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/attendance/events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "attendance", "events"]
            },
            "description": "Negative test - the face presented is below the 0.70 liveness threshold, so the scan is refused."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 422 Unprocessable Entity', () => pm.response.to.have.status(422));",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Error code is LIVENESS_FAILED', () =>",
                  "  pm.expect(json.error).to.eql('LIVENESS_FAILED'));",
                  "",
                  "pm.test('Uses the project error envelope', () =>",
                  "  pm.expect(json.statusCode).to.eql(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "Check In - Unknown Employee (expect 404)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{gym1StationCode}}\",\n  \"employeeId\": \"EMP-0000\",\n  \"type\": \"IN\",\n  \"livenessScore\": 0.9\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/attendance/events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "attendance", "events"]
            },
            "description": "Negative test - no employee carries this number."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 404 Not Found', () => pm.response.to.have.status(404));",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Error code is EMPLOYEE_NOT_FOUND', () =>",
                  "  pm.expect(json.error).to.eql('EMPLOYEE_NOT_FOUND'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Check In - Bad Station Code (expect 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"999999\",\n  \"employeeId\": \"{{employeeKarim}}\",\n  \"type\": \"IN\",\n  \"livenessScore\": 0.9\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/attendance/events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "attendance", "events"]
            },
            "description": "Negative test - no gym owns this station code."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401 Unauthorized', () => pm.response.to.have.status(401));",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Error code is INVALID_STATION_CODE', () =>",
                  "  pm.expect(json.error).to.eql('INVALID_STATION_CODE'));",
                  "",
                  "pm.test('Never echoes the station code back', () =>",
                  "  pm.expect(JSON.stringify(json)).to.not.include('999999'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Check In - Invalid Type (expect 400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{gym1StationCode}}\",\n  \"employeeId\": \"{{employeeKarim}}\",\n  \"type\": \"JUMP\",\n  \"livenessScore\": 0.9\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/attendance/events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "attendance", "events"]
            },
            "description": "Negative test - only `IN` and `OUT` are accepted."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Error code is INVALID_TYPE', () =>",
                  "  pm.expect(json.error).to.eql('INVALID_TYPE'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Check In - Cross Gym Denied (expect 403)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
