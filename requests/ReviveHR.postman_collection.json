    {
      "name": "04 - Station Codes",
      "description": "StationCodesController - `/api/gyms/{gymId}/station-codes`. **Requires a JWT** - the collection auto-JWT supplies it, so nothing is pasted by hand.\n\nCodes are generated server-side and never hardcoded. Set `gymId` (1 or 2) and run **Get Current Station Code** first - its test writes the live code into `gym{{gymId}}StationCode`, which the Kiosk and Attendance folders read. Rotating a code invalidates the previous one immediately, so the Rotate test writes the new code back the same way.",
      "item": [
        {
          "name": "Get Current Station Code",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/gyms/{{gymId}}/station-codes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gyms", "{{gymId}}", "station-codes"]
            },
            "description": "GET /api/gyms/{gymId}/station-codes - the gym's current active station code."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Returns the requested gym', () =>",
                  "  pm.expect(json.gymId).to.eql(Number(pm.environment.get('gymId'))));",
                  "",
                  "pm.test('Returns a 6-digit station code', () =>",
                  "  pm.expect(json.code).to.match(/^\\d{6}$/));",
                  "",
                  "pm.test('Gym has a name', () =>",
                  "  pm.expect(json.gymName).to.be.a('string').and.not.empty);",
                  "",
                  "pm.test('Records when the code was generated', () =>",
                  "  pm.expect(Date.parse(json.generatedAt)).to.be.a('number'));",
                  "",
                  "// Keep the attendance requests aligned with the live code (never hardcoded).",
                  "pm.environment.set('gym' + pm.environment.get('gymId') + 'StationCode', json.code);"
                ]
              }
            }
          ]
        },
        {
          "name": "Rotate Station Code",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/gyms/{{gymId}}/station-codes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gyms", "{{gymId}}", "station-codes"]
            },
            "description": "POST /api/gyms/{gymId}/station-codes - issues a new code and invalidates the old one immediately."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Returns a new 6-digit station code', () =>",
                  "  pm.expect(json.code).to.match(/^\\d{6}$/));",
                  "",
                  "pm.test('Same gym as requested', () =>",
                  "  pm.expect(json.gymId).to.eql(Number(pm.environment.get('gymId'))));",
                  "",
                  "pm.test('Regenerated just now', () =>",
                  "  pm.expect(Date.parse(json.generatedAt)).to.be.closeTo(Date.now(), 60000));",
                  "",
                  "// Keep the attendance folder working against the rotated code (gym-aware).",
                  "pm.environment.set('gym' + pm.environment.get('gymId') + 'StationCode', json.code);",
                  "console.log('Station code rotated to ' + json.code);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Station Code - No Token (expect 401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Skip-Auth",
                "value": "true",
                "description": "Opts this one request out of the collection's auto-JWT."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/gyms/{{gymId}}/station-codes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gyms", "{{gymId}}", "station-codes"]
            },
            "description": "Negative test - this is the only controller in the API that is not anonymous, so it is the one request that must prove the guard."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401 without a bearer token', () =>",
                  "  pm.response.to.have.status(401));",
                  "",
                  "pm.test('No Authorization header was sent', () =>",
                  "  pm.expect(pm.request.headers.get('Authorization')).to.eql(undefined));",
                  "",
                  "pm.test('No station code leaks', () =>",
                  "  pm.expect(pm.response.text()).to.not.match(/\"code\"\\s*:\\s*\"\\d{6}\"/));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Station Code - Cross Gym (IDOR guard)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/gyms/2/station-codes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gyms", "2", "station-codes"]
            },
            "description": "IDOR guard. The super admin is legitimately allowed across every gym, so this returns 200 by design; a gym-scoped employee gets 403 `GYM_ACCESS_DENIED`. Sign in as an employee in the Auth folder to exercise the guard."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Cross-gym access resolves against the caller role', function () {",
                  "  if (pm.response.code === 403) {",
                  "    pm.expect(pm.response.json().error).to.eql('GYM_ACCESS_DENIED');",
                  "  } else {",
                  "    pm.expect(pm.response.code, 'super admin reads across gyms by role').to.eql(200);",
                  "    console.log('Signed in as a cross-gym role - read is allowed by design.');",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
