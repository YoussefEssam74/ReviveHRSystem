### ============================================================
### Station-code sync — run these TWO first (after auth.http >
### adminLogin). Codes are generated server-side and never
### hardcoded: each response writes the live code into the
### environment for every other request in this folder and
### in kiosk.http.
### ============================================================

### Sync gym 1's live station code → sets {{gym1StationCode}}
# @name syncGym1StationCode
GET {{baseUrl}}/api/gyms/1/station-codes
Authorization: Bearer {{adminLogin.response.body.accessToken}}

> {%
client.global.set('gym1StationCode', response.body.code);
%}

###
### Sync gym 2's live station code → sets {{gym2StationCode}}
# @name syncGym2StationCode
GET {{baseUrl}}/api/gyms/2/station-codes
Authorization: Bearer {{adminLogin.response.body.accessToken}}

> {%
client.global.set('gym2StationCode', response.body.code);
%}

###
### ============================================================
### Attendance events — every request carries ONLY the 6-digit
### station code (no deviceId, no device token). gymId is resolved
### server-side from the code.
### Timestamp is optional; omit it to use server time.
### ============================================================

### Check-in (biometric) → 201
### NOTE: repeated runs return 409 ALREADY_CHECKED_IN for the same day.
# @name eventCheckIn
POST {{baseUrl}}/api/attendance/events
Content-Type: application/json

{
  "code": "{{gym1StationCode}}",
  "employeeId": "{{employeeKarim}}",
  "type": "IN",
  "livenessScore": 0.95
}

###
### Check-out (biometric) → 201 (after a check-in)
# @name eventCheckOut
POST {{baseUrl}}/api/attendance/events
Content-Type: application/json

{
  "code": "{{gym1StationCode}}",
  "employeeId": "{{employeeKarim}}",
  "type": "OUT",
  "livenessScore": 0.95
}

###
### Duplicate check-in → 409 ALREADY_CHECKED_IN
# @name eventDuplicateIn
POST {{baseUrl}}/api/attendance/events
Content-Type: application/json

{
  "code": "{{gym1StationCode}}",
  "employeeId": "{{employeeKarim}}",
  "type": "IN",
  "livenessScore": 0.95
}

###
### Liveness below 0.60 → 422 LIVENESS_FAILED
# @name eventLivenessFail
POST {{baseUrl}}/api/attendance/events
Content-Type: application/json

{
  "code": "{{gym1StationCode}}",
  "employeeId": "{{employeeKarim}}",
  "type": "IN",
  "livenessScore": 0.42
}

###
### Unknown employee → 404 EMPLOYEE_NOT_FOUND
# @name eventUnknownEmployee
POST {{baseUrl}}/api/attendance/events
Content-Type: application/json

{
  "code": "{{gym1StationCode}}",
  "employeeId": "EMP-0000",
  "type": "IN",
  "livenessScore": 0.9
}

###
### Karim (gym1 only) scanned at gym2 → 403 CROSS_GYM_ACCESS_DENIED
# @name eventCrossGymDenied
POST {{baseUrl}}/api/attendance/events
Content-Type: application/json

{
  "code": "{{gym2StationCode}}",
  "employeeId": "{{employeeKarim}}",
  "type": "IN",
  "livenessScore": 0.9
}

###
### Omar (access to both, scheduled at gym1) scanned at gym2 → 403 WRONG_BRANCH_SCHEDULE
# @name eventWrongBranch
POST {{baseUrl}}/api/attendance/events
Content-Type: application/json

{
  "code": "{{gym2StationCode}}",
  "employeeId": "{{employeeOmar}}",
  "type": "IN",
  "livenessScore": 0.9
}

###
### Sara (no shift today) → 404 SCHEDULED_DAY_OFF
# @name eventDayOff
POST {{baseUrl}}/api/attendance/events
Content-Type: application/json

{
  "code": "{{gym2StationCode}}",
  "employeeId": "{{employeeSara}}",
  "type": "IN",
  "livenessScore": 0.9
}

###
### Bad station code → 401 INVALID_STATION_CODE
# @name eventBadStationCode
POST {{baseUrl}}/api/attendance/events
Content-Type: application/json

{
  "code": "999999",
  "employeeId": "{{employeeKarim}}",
  "type": "IN",
  "livenessScore": 0.9
}

###
### Invalid type → 400 INVALID_TYPE
# @name eventInvalidType
POST {{baseUrl}}/api/attendance/events
Content-Type: application/json

{
  "code": "{{gym1StationCode}}",
  "employeeId": "{{employeeKarim}}",
  "type": "JUMP",
  "livenessScore": 0.9
}

###
### Manual check-in (Face ID fallback) → 201, method=Manual, reason audited
# @name manualCheckIn
POST {{baseUrl}}/api/attendance/manual
Content-Type: application/json

{
  "code": "{{gym1StationCode}}",
  "employeeId": "{{employeeOmar}}",
  "type": "IN",
  "reason": "Face ID camera offline"
}

###
### ============================================================
### HR station-code management (requires JWT)
### ============================================================

###
### Get current station code (admin) → 200
# @name getCurrentStationCode
GET {{baseUrl}}/api/gyms/1/station-codes
Authorization: Bearer {{adminLogin.response.body.accessToken}}

###
### Get station code without token → 401
# @name getStationCodeAnonymous
GET {{baseUrl}}/api/gyms/1/station-codes

###
### Employee accessing another gym's station code → 403 GYM_ACCESS_DENIED (IDOR guard)
# @name getStationCodeCrossGym
GET {{baseUrl}}/api/gyms/2/station-codes
Authorization: Bearer {{employeeLogin.response.body.accessToken}}

###
### Rotate the station code → 200 (old code stops working immediately)
# @name rotateStationCode
POST {{baseUrl}}/api/gyms/2/station-codes
Authorization: Bearer {{adminLogin.response.body.accessToken}}
